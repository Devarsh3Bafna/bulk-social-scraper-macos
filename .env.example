# Meta / Facebook Graph API Credentials (Optional - Scraper runs without login)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ID=your_meta_page_id
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token

# Graph API version
META_GRAPH_API_VERSION=v26.0

# Social data auto-sync interval in minutes
SOCIAL_SYNC_INTERVAL_MINUTES=7
